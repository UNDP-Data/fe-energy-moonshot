AZURE_OPENAI_KEY=your_azure_openai_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-03-01-preview
AZURE_OPENAI_MOONSHOT_PARSE_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_MOONSHOT_SYNOPSIS_DEPLOYMENT=gpt-4.1-mini
PORT=3001
HOST=127.0.0.1

# Optional: restrict browser origins in production.
# ALLOWED_ORIGINS=https://undp-data.github.io

# Optional: Moonshot abuse controls.
# MOONSHOT_RATE_LIMIT_WINDOW_SECONDS=300
# MOONSHOT_PARSE_RATE_LIMIT=60
# MOONSHOT_SYNOPSIS_RATE_LIMIT=120

# Optional compatibility fallbacks.
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_CHAT_MODEL=gpt-4.1-mini
# AZURE_OPENAI_PARSE_DEPLOYMENT=gpt-4.1-mini
# AZURE_OPENAI_SYNOPSIS_DEPLOYMENT=gpt-4.1-mini
# OPENAI_API_KEY=
# OPENAI_PARSE_MODEL=gpt-4.1-mini
# OPENAI_SYNOPSIS_MODEL=gpt-4.1-mini
